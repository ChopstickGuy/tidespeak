// Farben und Maße nach Frametide OS (dunkles libadwaita, Akzent Blau, Marke Türkis/Violett)

export global Theme {
    out property <color> window: #242424;
    out property <color> sidebar: #303030;
    out property <color> sidebar-hover: #3a3a3a;
    out property <color> sidebar-selected: #444444;
    out property <color> panel: #2a2a2a;
    out property <color> card: #353535;
    out property <color> card-hover: #3b3b3b;
    out property <color> separator: #ffffff0f;
    out property <color> entry: #393939;
    out property <color> border: #ffffff12;

    out property <color> accent: #3584e4;
    out property <color> accent-hover: #4a91e8;
    out property <color> accent-pressed: #2a6fc4;
    out property <color> teal: #22d3ee;
    out property <color> purple: #a855f7;
    out property <color> success: #2ec27e;
    out property <color> warning: #e5a50a;
    out property <color> error: #ff7b63;
    out property <color> destructive: #c01c28;

    out property <color> text: #ffffff;
    out property <color> text-dim: #ffffff8c;
    out property <color> text-faint: #ffffff59;

    out property <length> radius: 12px;
    out property <length> radius-small: 8px;
    out property <length> font: 14px;
    out property <length> font-small: 12px;
    out property <length> font-title: 15px;
}
