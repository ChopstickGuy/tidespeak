// Tidespeak – Fenster. Die ganze Oberfläche ist ein Zeichenraster, das Rust zeichnet
// (crates/client/src/ui). Slint zeigt das Bild, meldet Maus und Tastatur und stellt
// drei echte Eingabefelder bereit (Einfügen, Auswahl, Eingabemethoden).

import "../assets/fonts/JetBrainsMono-Regular.ttf";
import "../assets/fonts/JetBrainsMono-Bold.ttf";

// Ein Ausschnitt des Zeichenrasters – nur geänderte Kacheln werden neu übertragen
export struct Tile {
    x: length,
    y: length,
    w: length,
    h: length,
    img: image,
}

component Field inherits TextInput {
    in property <bool> shown;
    in property <length> fx;
    in property <length> fy;
    in property <length> fw;
    x: root.fx;
    y: root.fy;
    width: root.fw;
    height: 16px;
    visible: root.shown;
    enabled: root.shown;
    single-line: true;
    font-family: "JetBrains Mono";
    font-size: 13.333px;
    color: #ffffff;
    vertical-alignment: center;
    selection-background-color: #22d3ee66;
    selection-foreground-color: #ffffff;
}

export component MainWindow inherits Window {
    title: "Tidespeak";
    icon: @image-url("../assets/tidespeak.svg");
    preferred-width: 1440px;
    preferred-height: 896px;
    min-width: 1360px;
    min-height: 720px;
    no-frame: true;
    background: #141416;
    default-font-family: "JetBrains Mono";

    in property <[Tile]> tiles;
    in property <bool> is-maximized;
    in property <bool> hand;

    // Eingabefelder: 0 = Server, 1 = Name, 2 = Chat
    in-out property <string> text0;
    in-out property <string> text1;
    in-out property <string> text2;
    in property <bool> shown0;
    in property <bool> shown1;
    in property <bool> shown2;
    in property <length> x0;
    in property <length> y0;
    in property <length> w0;
    in property <length> x1;
    in property <length> y1;
    in property <length> w1;
    in property <length> x2;
    in property <length> y2;
    in property <length> w2;

    callback mouse(string, length, length);
    callback scrolled(length, length, length);
    callback key(string, bool) -> bool;
    callback field-edited(int, string);
    callback field-accepted(int);
    callback start-resize(int);

    public function focus-field(i: int) {
        if (i == 0) { f0.focus(); }
        if (i == 1) { f1.focus(); }
        if (i == 2) { f2.focus(); }
        if (i < 0) { fs.focus(); }
    }

    fs := FocusScope {
        key-pressed(e) => {
            if (root.key(e.text, true)) { return accept; }
            return reject;
        }
        key-released(e) => {
            if (root.key(e.text, false)) { return accept; }
            return reject;
        }
        for t in root.tiles: Image {
            x: t.x;
            y: t.y;
            width: t.w;
            height: t.h;
            source: t.img;
            image-rendering: pixelated;
        }
        TouchArea {
            mouse-cursor: root.hand ? pointer : default;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.mouse("down", self.mouse-x, self.mouse-y);
                }
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                    root.mouse("up", self.mouse-x, self.mouse-y);
                }
            }
            moved => { root.mouse("move", self.mouse-x, self.mouse-y); }
            changed has-hover => {
                if (!self.has-hover) { root.mouse("leave", 0, 0); }
            }
            double-clicked => { root.mouse("double", self.mouse-x, self.mouse-y); }
            scroll-event(e) => {
                root.scrolled(self.mouse-x, self.mouse-y, e.delta-y);
                return accept;
            }
        }
        f0 := Field {
            shown: root.shown0;
            fx: root.x0;
            fy: root.y0;
            fw: root.w0;
            text <=> root.text0;
            edited => { root.field-edited(0, self.text); }
            accepted => { root.field-accepted(0); }
        }
        f1 := Field {
            shown: root.shown1;
            fx: root.x1;
            fy: root.y1;
            fw: root.w1;
            text <=> root.text1;
            edited => { root.field-edited(1, self.text); }
            accepted => { root.field-accepted(1); }
        }
        f2 := Field {
            shown: root.shown2;
            fx: root.x2;
            fy: root.y2;
            fw: root.w2;
            text <=> root.text2;
            edited => { root.field-edited(2, self.text); }
            accepted => { root.field-accepted(2); }
        }
    }

    // Größe ändern (eigene Fensterdekoration)
    if !root.is-maximized: TouchArea {
        x: 0;
        y: 6px;
        width: 5px;
        height: parent.height - 12px;
        mouse-cursor: ew-resize;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.start-resize(6); } }
    }
    if !root.is-maximized: TouchArea {
        x: parent.width - 5px;
        y: 6px;
        width: 5px;
        height: parent.height - 12px;
        mouse-cursor: ew-resize;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.start-resize(2); } }
    }
    if !root.is-maximized: TouchArea {
        x: 6px;
        y: parent.height - 5px;
        width: parent.width - 12px;
        height: 5px;
        mouse-cursor: ns-resize;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.start-resize(4); } }
    }
    if !root.is-maximized: TouchArea {
        x: parent.width - 8px;
        y: parent.height - 8px;
        width: 8px;
        height: 8px;
        mouse-cursor: nwse-resize;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.start-resize(3); } }
    }
    if !root.is-maximized: TouchArea {
        x: 0;
        y: parent.height - 8px;
        width: 8px;
        height: 8px;
        mouse-cursor: nesw-resize;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.start-resize(5); } }
    }

    init => { fs.focus(); }
}
