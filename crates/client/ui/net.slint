// Netz-Ansicht: Server im Zentrum, Kanäle als Sechsecke, Personen als Knoten daran.
// Koordinaten kommen aus Rust in "Einheiten" (1.0 = halbe kürzere Seite der Fläche)
// und werden hier mit Zoom und Verschiebung auf Pixel abgebildet.

import { Theme } from "theme.slint";
import { Icon, Slider, CutPanel, MonoLabel } from "widgets.slint";

export struct NetChannel {
    id: int,
    code: string,
    name: string,
    x: float,
    y: float,
    r: float,
    count: int,
    current: bool,
}

export struct NetUser {
    id: int,
    name: string,
    initial: string,
    color: color,
    // Position der Person und ihres Kanals
    x: float,
    y: float,
    cx: float,
    cy: float,
    // Größe des Kanal-Knotens (Radius in Einheiten)
    cr: float,
    speaking: bool,
    muted: bool,
    deafened: bool,
    away: bool,
    me: bool,
    level: float,
    quality: int,
    status: string,
    // Kürzel des Kanals (CH-01)
    chan: string,
    // im eigenen Kanal (sonst kleiner und dezenter)
    near: bool,
}

// Gerade Linie zwischen zwei Punkten (in Pixeln des Elternelements),
// an beiden Enden um trim1/trim2 gekürzt, damit sie am Rand der Knoten endet
component Wire inherits Path {
    in property <length> x1;
    in property <length> y1;
    in property <length> x2;
    in property <length> y2;
    in property <length> trim1;
    in property <length> trim2;
    property <float> dx: (root.x2 - root.x1) / 1px;
    property <float> dy: (root.y2 - root.y1) / 1px;
    property <float> len: Math.max(0.001, Math.sqrt(root.dx * root.dx + root.dy * root.dy));
    property <bool> gone: root.len * 1px <= root.trim1 + root.trim2;
    property <length> ax: root.x1 + root.dx / root.len * root.trim1;
    property <length> ay: root.y1 + root.dy / root.len * root.trim1;
    property <length> bx: root.x2 - root.dx / root.len * root.trim2;
    property <length> by: root.y2 - root.dy / root.len * root.trim2;
    property <length> pad: 4px;
    visible: !root.gone;
    x: Math.min(root.ax, root.bx) - root.pad;
    y: Math.min(root.ay, root.by) - root.pad;
    width: Math.abs(root.bx - root.ax) + 2 * root.pad;
    height: Math.abs(root.by - root.ay) + 2 * root.pad;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    commands: "M " + (root.ax - self.x) / 1px + " " + (root.ay - self.y) / 1px + " L " + (root.bx - self.x) / 1px + " " + (root.by - self.y) / 1px;
    fill: transparent;
}

component ChannelHex inherits Rectangle {
    in property <NetChannel> ch;
    in property <length> size;
    callback clicked();
    width: root.size;
    height: root.size;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 25 3 L 75 3 L 100 50 L 75 97 L 25 97 L 0 50 Z";
        fill: root.ch.current ? #22d3ee29 : ta.has-hover ? #ffffff1a : root.ch.count > 0 ? #2e2e30 : #2a2a2c;
        stroke: root.ch.current ? Theme.teal : ta.has-hover ? #22d3ee99 : #ffffff1f;
        stroke-width: root.ch.current ? 2px : 1px;
    }
    ta := TouchArea {
        enabled: !root.ch.current;
        mouse-cursor: root.ch.current ? default : pointer;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: root.ch.code;
            font-family: "JetBrains Mono";
            font-size: 10px;
            letter-spacing: 1.6px;
            color: root.ch.current ? Theme.teal : Theme.text-faint;
            horizontal-alignment: center;
        }
        Text {
            text: root.ch.name;
            font-weight: 700;
            font-size: root.ch.current ? 19px : 13px;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.ch.count > 0 ? root.ch.count + " ONLINE" : "FREI";
            font-family: "JetBrains Mono";
            font-size: 9px;
            color: Theme.text-dim;
            horizontal-alignment: center;
        }
        if !root.ch.current: Text {
            text: "BEITRETEN ›";
            font-family: "JetBrains Mono";
            font-size: 9px;
            letter-spacing: 1.2px;
            color: ta.has-hover ? Theme.teal : Theme.teal.transparentize(0.35);
            horizontal-alignment: center;
        }
    }
}

component UserNode inherits Rectangle {
    in property <NetUser> user;
    in property <float> k: 1.0;
    in property <bool> selected;
    callback clicked();
    out property <length> av: (root.user.near ? 42px : 32px) * root.k;
    property <color> ring: root.user.speaking ? (root.user.quality == 2 ? Theme.warning : Theme.teal)
        : root.user.muted || root.user.deafened ? Theme.destructive : transparent;
    width: 120px * root.k;
    height: root.av + 40px * root.k;

    // Leuchten beim Sprechen, wächst mit der Lautstärke
    if root.user.speaking: Rectangle {
        property <length> s: root.av + (12px + root.user.level * 16px) * root.k;
        x: (parent.width - self.s) / 2;
        y: root.av / 2 - self.s / 2;
        width: self.s;
        height: self.s;
        border-radius: self.s / 2;
        background: root.ring.transparentize(0.75);
        animate width, height, x, y { duration: 80ms; }
    }
    // Ring (sprechen = türkis, stumm = rot) bzw. Auswahl
    Rectangle {
        x: (parent.width - root.av - 10px) / 2;
        y: -5px;
        width: root.av + 10px;
        height: root.av + 10px;
        border-radius: self.width / 2;
        border-width: root.selected ? 2px : root.ring == transparent ? 1px : 2px;
        border-color: root.selected ? #ffffff : root.ring == transparent ? #ffffff1f : root.ring;
        background: Theme.window;
    }
    Rectangle {
        x: (parent.width - root.av) / 2;
        y: 0;
        width: root.av;
        height: root.av;
        border-radius: root.av / 2;
        background: root.user.color;
        opacity: root.user.away ? 0.4 : 1.0;
        Text { text: root.user.initial; color: #ffffff; font-weight: 700; font-size: root.av * 0.4; }
    }
    Text {
        y: root.av + 8px;
        width: parent.width;
        text: root.user.name + (root.user.me ? " (du)" : "");
        color: root.user.near ? Theme.text : Theme.text-dim;
        font-weight: 600;
        font-size: root.user.near ? 12px : 11px;
        horizontal-alignment: center;
        overflow: elide;
    }
    Text {
        y: root.av + 24px;
        width: parent.width;
        text: root.user.status;
        font-family: "JetBrains Mono";
        font-size: 9px;
        letter-spacing: 1.2px;
        horizontal-alignment: center;
        overflow: elide;
        color: root.user.quality == 2 && root.user.speaking ? Theme.warning
            : root.user.speaking ? Theme.teal
            : root.user.muted || root.user.deafened ? Theme.error
            : Theme.text-dim;
    }
    TouchArea {
        enabled: !root.user.me;
        mouse-cursor: root.user.me ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// Datenpaket, das während des Sprechens von der Person zum Kanal wandert
component Packet inherits Rectangle {
    in property <length> x1;
    in property <length> y1;
    in property <length> x2;
    in property <length> y2;
    in property <float> phase;
    in property <float> pulse;
    in property <color> tint;
    // bewegt sich im Takt der Oberfläche (80 ms) statt mit 60 Bildern pro Sekunde –
    // der Software-Renderer zeichnet sonst ständig das ganze Fenster neu
    in property <length> trim1;
    in property <length> trim2;
    property <float> raw: root.pulse + root.phase;
    property <float> t: root.raw - Math.floor(root.raw);
    property <float> dx: (root.x2 - root.x1) / 1px;
    property <float> dy: (root.y2 - root.y1) / 1px;
    property <float> len: Math.max(0.001, Math.sqrt(root.dx * root.dx + root.dy * root.dy));
    // nur auf dem sichtbaren Stück der Leitung zwischen den Knoten
    property <float> f1: Math.min(0.5, root.trim1 / 1px / root.len);
    property <float> f2: Math.max(0.5, 1 - root.trim2 / 1px / root.len);
    property <float> f: root.f1 + (root.f2 - root.f1) * root.t;
    visible: root.f2 - root.f1 > 0.05;
    x: root.x1 + (root.x2 - root.x1) * root.f - 3px;
    y: root.y1 + (root.y2 - root.y1) * root.f - 3px;
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: root.tint;
}

export component NetView inherits Rectangle {
    in property <[NetChannel]> channels;
    in property <[NetUser]> users;
    in property <string> server-name;
    // Fortschritt der Datenpakete 0…1
    in property <float> pulse;
    in-out property <float> zoom: 1.0;
    in-out property <length> pan-x;
    in-out property <length> pan-y;
    // Personen-Karte
    in-out property <int> card-index: -1;
    in-out property <float> card-volume: 0.5;
    in property <string> card-loss;
    in property <string> card-buffer;
    in property <string> card-jitter;
    // 0 gut, 1 wackelig, 2 schlecht
    in property <int> card-tone;
    // Ausdehnung des Netzes in Einheiten (Rust), damit alles hineinpasst
    in property <float> extent-x: 1.2;
    in property <float> extent-y: 1.2;
    callback join(int);
    callback user-clicked(int, string);
    callback card-volume-moved(float);
    callback card-volume-done();
    callback card-poke();

    // unten liegen Steuerleiste und eigenes Feld – das Netz sitzt darüber
    in property <length> bottom-reserve: 84px;
    property <length> unit: Math.min(root.width / (2 * root.extent-x), (root.height - root.bottom-reserve) / (2 * root.extent-y)) * root.zoom;
    property <length> mx: root.width / 2 + root.pan-x;
    property <length> my: (root.height - root.bottom-reserve) / 2 + 10px + root.pan-y;
    property <float> k: Math.max(0.75, Math.min(1.25, root.unit / 280px));
    property <bool> card-local-muted: root.card-volume < 0.005;
    pure function hex-size(r: float, current: bool) -> length {
        return Math.max(2 * r * root.unit, (current ? 120px : 96px) * root.k);
    }
    property <length> server-r: 60px * root.k;
    property <length> drag-x;
    property <length> drag-y;
    clip: true;

    // Punktraster im Hintergrund
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../assets/grid-dot.svg");
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
    }
    // Verschieben mit gedrückter Maustaste, Klick ins Leere schließt die Karte
    TouchArea {
        mouse-cursor: self.pressed ? grabbing : default;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.drag-x = root.pan-x;
                root.drag-y = root.pan-y;
            }
        }
        moved => {
            root.pan-x = root.drag-x + self.mouse-x - self.pressed-x;
            root.pan-y = root.drag-y + self.mouse-y - self.pressed-y;
        }
        clicked => { root.card-index = -1; }
        scroll-event(e) => {
            root.zoom = Math.max(0.5, Math.min(2.2, root.zoom * (e.delta-y > 0 ? 1.1 : 1 / 1.1)));
            return accept;
        }
    }

    // Verbindungen: Server -> Kanal
    for c in root.channels: Wire {
        x1: root.mx;
        y1: root.my;
        x2: root.mx + c.x * root.unit;
        y2: root.my + c.y * root.unit;
        trim1: root.server-r;
        trim2: root.hex-size(c.r, c.current) * 0.44;
        stroke: c.current ? #22d3ee99 : c.count > 0 ? #ffffff40 : #a855f74d;
        stroke-width: c.current ? 2px : 1px;
    }
    // Verbindungen: Kanal -> Person (sprechend mit Leuchtspur)
    for u in root.users: Wire {
        x1: root.mx + u.cx * root.unit;
        y1: root.my + u.cy * root.unit;
        x2: root.mx + u.x * root.unit;
        y2: root.my + u.y * root.unit;
        trim1: root.hex-size(u.cr, u.near) * 0.44;
        trim2: (u.near ? 26px : 21px) * root.k;
        stroke: u.speaking ? (u.quality == 2 ? #e5a50a80 : #22d3ee59) : #00000000;
        stroke-width: 7px;
    }
    for u in root.users: Wire {
        x1: root.mx + u.cx * root.unit;
        y1: root.my + u.cy * root.unit;
        x2: root.mx + u.x * root.unit;
        y2: root.my + u.y * root.unit;
        trim1: root.hex-size(u.cr, u.near) * 0.44;
        trim2: (u.near ? 26px : 21px) * root.k;
        stroke: u.speaking ? (u.quality == 2 ? Theme.warning : Theme.teal)
            : u.muted || u.deafened ? #ff7b6359 : #ffffff29;
        stroke-width: u.speaking ? 2px : 1px;
    }
    // Datenpakete der Sprechenden
    for u in root.users: Rectangle {
        visible: u.speaking;
        if u.speaking: Packet {
            x1: root.mx + u.x * root.unit;
            y1: root.my + u.y * root.unit;
            x2: root.mx + u.cx * root.unit;
            y2: root.my + u.cy * root.unit;
            phase: 0;
            pulse: root.pulse;
            trim1: (u.near ? 26px : 21px) * root.k;
            trim2: root.hex-size(u.cr, u.near) * 0.44;
            tint: u.quality == 2 ? Theme.warning : Theme.teal;
        }
        if u.speaking: Packet {
            x1: root.mx + u.x * root.unit;
            y1: root.my + u.y * root.unit;
            x2: root.mx + u.cx * root.unit;
            y2: root.my + u.cy * root.unit;
            phase: 0.5;
            pulse: root.pulse;
            trim1: (u.near ? 26px : 21px) * root.k;
            trim2: root.hex-size(u.cr, u.near) * 0.44;
            tint: u.quality == 2 ? Theme.warning : Theme.teal;
        }
    }

    // Server-Kern
    Rectangle {
        property <length> s: 100px * root.k;
        x: root.mx - self.s / 2 - 10px * root.k;
        y: root.my - self.s / 2 - 10px * root.k;
        width: self.s + 20px * root.k;
        height: self.width;
        border-radius: self.width / 2;
        background: #a855f714;
        Rectangle {
            x: 10px * root.k;
            y: 10px * root.k;
            width: parent.s;
            height: parent.s;
            border-radius: parent.s / 2;
            background: #26262b;
            border-width: 2px;
            border-color: #a855f7b3;
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text { text: "SERVER"; font-family: "JetBrains Mono"; font-size: 9px; letter-spacing: 1.8px; color: Theme.purple; horizontal-alignment: center; }
                Text { text: root.server-name; font-size: 12px; font-weight: 700; color: Theme.text; horizontal-alignment: center; overflow: elide; }
            }
        }
    }

    // Kanäle
    for c in root.channels: ChannelHex {
        ch: c;
        size: root.hex-size(c.r, c.current);
        x: root.mx + c.x * root.unit - self.size / 2;
        y: root.my + c.y * root.unit - self.size / 2;
        clicked => { root.join(c.id); }
    }

    // Personen
    for u[i] in root.users: UserNode {
        user: u;
        k: root.k;
        selected: root.card-index == i;
        x: root.mx + u.x * root.unit - self.width / 2;
        y: root.my + u.y * root.unit - self.av / 2;
        clicked => {
            root.card-index = i;
            root.user-clicked(u.id, u.name);
        }
    }

    // Personen-Karte neben dem angeklickten Knoten, mit Leitlinie
    if root.card-index >= 0 && root.card-index < root.users.length: Rectangle {
        property <NetUser> u: root.users[root.card-index];
        property <length> px: root.mx + self.u.x * root.unit;
        property <length> py: root.my + self.u.y * root.unit;
        // Karte in die obere Ecke auf der Seite der Person (wie ein Head-up-Display);
        // liegt die Person selbst in dieser Ecke, kommt die Karte in die andere
        property <length> cw: 300px;
        property <length> ch: card.preferred-height;
        property <bool> person-left: self.px < root.width / 2;
        property <bool> in-corner: self.py < 40px + self.ch + 40px && (self.person-left ? self.px < 24px + self.cw + 40px : self.px > root.width - self.cw - 64px);
        property <bool> left-side: self.person-left != self.in-corner;
        // rechts oben liegen die Zoom-Knöpfe
        property <length> cx: self.left-side ? 24px : root.width - self.cw - 72px;
        property <length> cy: 40px;
        // Leitlinie: von unten, wenn die Person unter der Karte liegt, sonst von der Seite
        property <bool> below: self.py > self.cy + self.ch + 20px;
        property <length> ax: self.below ? Math.max(self.cx + 30px, Math.min(self.cx + self.cw - 30px, self.px))
            : self.px > self.cx + self.cw / 2 ? self.cx + self.cw : self.cx;
        property <length> ay: self.below ? self.cy + self.ch : self.cy + 34px;
        Wire {
            x1: parent.px;
            y1: parent.py;
            x2: parent.ax;
            y2: parent.ay;
            trim1: (parent.u.near ? 28px : 23px) * root.k;
            stroke: #22d3ee99;
            stroke-width: 1px;
        }
        Rectangle {
            x: parent.ax - 5px;
            y: parent.ay - 5px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: Theme.teal;
            drop-shadow-blur: 10px;
            drop-shadow-color: Theme.teal;
        }
        CutPanel {
            x: parent.cx;
            y: parent.cy;
            width: parent.cw;
            height: parent.ch;
            cut: 14px;
            fill: #303030f7;
            stroke: #22d3ee66;
            TouchArea { }
            card := VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 50px;
                        height: 50px;
                        border-radius: 25px;
                        border-width: 2px;
                        border-color: u.speaking ? Theme.teal : #ffffff2e;
                        Rectangle {
                            width: 42px;
                            height: 42px;
                            border-radius: 21px;
                            background: u.color;
                            Text { text: u.initial; color: #ffffff; font-weight: 700; font-size: 18px; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        horizontal-stretch: 1;
                        Text { text: u.name; color: Theme.text; font-weight: 700; font-size: 16px; overflow: elide; }
                        MonoLabel {
                            text: (u.status == "" ? "VERBUNDEN" : u.status) + " · " + u.chan;
                            color: u.speaking ? Theme.teal : u.muted || u.deafened ? Theme.error : Theme.text-dim;
                            overflow: elide;
                        }
                    }
                    VerticalLayout {
                        alignment: start;
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            background: xta.has-hover ? #ffffff21 : #ffffff14;
                            xta := TouchArea { mouse-cursor: pointer; clicked => { root.card-index = -1; } }
                            Icon { source: @image-url("../assets/icons/x.svg"); width: 11px; height: 11px; }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        MonoLabel { text: "VERLUST"; font-size: 9px; }
                        Text {
                            text: root.card-loss;
                            font-family: "JetBrains Mono";
                            font-size: 13px;
                            color: root.card-tone == 0 ? Theme.success : root.card-tone == 1 ? Theme.warning : Theme.error;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        MonoLabel { text: "PUFFER"; font-size: 9px; }
                        Text { text: root.card-buffer; font-family: "JetBrains Mono"; font-size: 13px; color: Theme.text; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        MonoLabel { text: "JITTER"; font-size: 9px; }
                        Text { text: root.card-jitter; font-family: "JetBrains Mono"; font-size: 13px; color: Theme.text; }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    MonoLabel { text: "VOL"; font-size: 11px; letter-spacing: 1px; }
                    Slider {
                        horizontal-stretch: 1;
                        value <=> root.card-volume;
                        moved(v) => { root.card-volume-moved(v); }
                        released(v) => { root.card-volume-done(); }
                    }
                    Text {
                        text: Math.round(root.card-volume * 200) + "%";
                        width: 40px;
                        font-family: "JetBrains Mono";
                        font-size: 11px;
                        color: Theme.text;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 36px;
                        horizontal-stretch: 1;
                        border-radius: Theme.radius-small;
                        border-width: 1px;
                        border-color: #ffffff26;
                        background: pta.pressed ? #ffffff26 : pta.has-hover ? #ffffff1a : #ffffff0f;
                        pta := TouchArea { mouse-cursor: pointer; clicked => { root.card-poke(); } }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            VerticalLayout { alignment: center; Icon { source: @image-url("../assets/icons/bell-ring.svg"); width: 14px; height: 14px; } }
                            Text { text: "Anstupsen"; color: Theme.text; font-weight: 600; font-size: 13px; vertical-alignment: center; }
                        }
                    }
                    Rectangle {
                        height: 36px;
                        horizontal-stretch: 1;
                        border-radius: Theme.radius-small;
                        border-width: 1px;
                        border-color: root.card-local-muted ? #ff7b6380 : #ffffff26;
                        background: root.card-local-muted ? #c01c2840 : mta.pressed ? #ffffff26 : mta.has-hover ? #ffffff1a : #ffffff0f;
                        mta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.card-volume = root.card-local-muted ? 0.5 : 0;
                                root.card-volume-moved(root.card-volume);
                                root.card-volume-done();
                            }
                        }
                        Text {
                            text: root.card-local-muted ? "Wieder anhören" : "Für mich stumm";
                            color: Theme.text;
                            font-weight: 600;
                            font-size: 13px;
                        }
                    }
                }
            }
        }
    }
}
