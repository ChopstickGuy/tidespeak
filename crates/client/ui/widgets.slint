// Bausteine im Frametide-/libadwaita-Stil

import { Theme } from "theme.slint";

export component Icon inherits Image {
    in property <color> tint: Theme.text;
    colorize: tint;
    width: 18px;
    height: 18px;
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> primary: false;
    in property <bool> destructive: false;
    in property <bool> flat: false;
    in property <bool> enabled: true;
    in property <length> icon-size: 16px;
    callback clicked();

    min-height: 34px;
    min-width: 34px;
    border-radius: Theme.radius-small;
    opacity: enabled ? 1 : 0.5;
    background: primary ? (ta.pressed ? Theme.accent-pressed : ta.has-hover ? Theme.accent-hover : Theme.accent)
        : destructive ? (ta.pressed ? #a51d2d : ta.has-hover ? #d02535 : Theme.destructive)
        : flat ? (ta.pressed ? #ffffff26 : ta.has-hover ? #ffffff14 : transparent)
        : (ta.pressed ? #ffffff30 : ta.has-hover ? #ffffff21 : #ffffff17);
    animate background { duration: 120ms; }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: root.text == "" ? 0px : 16px;
        padding-right: root.text == "" ? 0px : 16px;
        spacing: 8px;
        alignment: center;
        if root.has-icon: VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: root.icon-size;
                height: root.icon-size;
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: Theme.text;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

// Runde Fenster-/Werkzeugknöpfe wie im Frametide-Header
export component RoundButton inherits Rectangle {
    in property <image> icon;
    in property <color> tint: Theme.text;
    in property <bool> active: false;
    in property <color> active-color: Theme.error;
    in property <length> size: 26px;
    in property <length> icon-size: 14px;
    in property <string> tooltip;
    callback clicked();

    width: size;
    height: size;
    border-radius: size / 2;
    background: active ? active-color.transparentize(0.75)
        : ta.pressed ? #ffffff30 : ta.has-hover ? #ffffff21 : #ffffff14;
    animate background { duration: 120ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Icon {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        tint: root.active ? root.active-color : root.tint;
    }
}

export component Entry inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    callback edited(string);
    public function focus-input() { input.focus(); }

    height: 36px;
    border-radius: Theme.radius-small;
    background: Theme.entry;
    border-width: input.has-focus ? 2px : 0px;
    border-color: Theme.accent.transparentize(0.35);
    opacity: enabled ? 1 : 0.6;
    clip: true;

    if input.text == "": Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.text-faint;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        enabled: root.enabled;
        single-line: true;
        color: Theme.text;
        vertical-alignment: center;
        selection-background-color: Theme.accent.transparentize(0.4);
        selection-foreground-color: Theme.text;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
    }
}

export component Switch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 46px;
    height: 26px;
    border-radius: 13px;
    opacity: enabled ? 1 : 0.5;
    background: checked ? Theme.accent : #ffffff26;
    animate background { duration: 150ms; }
    Rectangle {
        width: 20px;
        height: 20px;
        y: 3px;
        x: root.checked ? root.width - self.width - 3px : 3px;
        border-radius: 10px;
        background: root.checked ? #ffffff : #d2d2d2;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000050;
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component Radio inherits Rectangle {
    in property <bool> checked;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background: checked ? Theme.accent : transparent;
    border-width: checked ? 0px : 2px;
    border-color: #ffffff40;
    animate background { duration: 120ms; }
    Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: #ffffff;
        visible: root.checked;
    }
}

export component Slider inherits Rectangle {
    in-out property <float> value; // 0 … 1
    in property <bool> enabled: true;
    callback moved(float);
    callback released(float);

    height: 26px;
    opacity: enabled ? 1 : 0.5;
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: #ffffff26;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 4px) / 2;
        width: 10px + (parent.width - 20px) * root.value;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
    knob := Rectangle {
        width: 20px;
        height: 20px;
        x: (root.width - self.width) * root.value;
        y: (root.height - self.height) / 2;
        border-radius: 10px;
        background: ta.pressed ? #ffffff : #e8e8e8;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000060;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.value = max(0, min(1, (self.mouse-x - 10px) / (root.width - 20px)));
                root.moved(root.value);
            }
            if (e.kind == PointerEventKind.up) {
                root.released(root.value);
            }
        }
        moved => {
            if (self.pressed) {
                root.value = max(0, min(1, (self.mouse-x - 10px) / (root.width - 20px)));
                root.moved(root.value);
            }
        }
    }
}

// Pegelanzeige mit Schwellen-Markierung (Sprachaktivierung)
export component LevelMeter inherits Rectangle {
    in property <float> level;
    in property <float> threshold: -1;
    in property <bool> active;

    height: 8px;
    border-radius: 4px;
    background: #ffffff1a;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * root.level;
        border-radius: 4px;
        background: root.active ? Theme.success : Theme.accent.transparentize(0.2);
        animate width { duration: 60ms; }
    }
    if root.threshold >= 0: Rectangle {
        x: parent.width * root.threshold - 1px;
        width: 2px;
        background: #ffffffcc;
    }
}

export component Avatar inherits Rectangle {
    in property <string> initial;
    in property <color> fill;
    in property <bool> speaking;
    in property <length> size: 32px;

    width: size;
    height: size;
    border-radius: size / 2;
    border-width: speaking ? 2px : 0px;
    border-color: Theme.teal;
    background: speaking ? Theme.teal.transparentize(0.75) : transparent;
    animate border-width { duration: 100ms; }
    Rectangle {
        width: root.size - 6px;
        height: root.size - 6px;
        border-radius: self.width / 2;
        background: root.fill;
        Text {
            text: root.initial;
            color: #ffffff;
            font-weight: 700;
            font-size: root.size * 0.42;
        }
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tone: #ffffff;
    border-radius: 99px;
    background: tone.transparentize(0.86);
    height: 20px;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            color: root.tone.mix(Theme.text, 0.5);
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// Karte mit Zeilen ("boxed list")
export component BoxedList inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius;
    clip: true;
    VerticalLayout {
        @children
    }
}

export component Row inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> separator: true;
    in property <bool> activatable: false;
    in property <bool> dimmed: false;
    callback activated();

    min-height: subtitle == "" ? 52px : 62px;
    background: activatable && ta.has-hover ? #ffffff08 : transparent;
    ta := TouchArea {
        enabled: root.activatable;
        mouse-cursor: root.activatable ? pointer : default;
        clicked => { root.activated(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        if root.has-icon: VerticalLayout {
            alignment: center;
            Icon { source: root.icon; tint: root.dimmed ? Theme.text-dim : Theme.text; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: root.dimmed ? Theme.text-dim : Theme.text;
                overflow: elide;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.text-dim;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 10px;
            @children
        }
    }
    if root.separator: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.separator;
    }
}

export component GroupTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 4px;
    padding-bottom: 6px;
    Text {
        text: root.title;
        font-weight: 700;
        font-size: Theme.font-title;
        color: Theme.text;
    }
    if root.description != "": Text {
        text: root.description;
        color: Theme.text-dim;
        wrap: word-wrap;
    }
}

// Rundet Verlaufsflächen ab: Der Software-Renderer zeichnet Verläufe eckig, abgerundete
// Rahmen aber exakt. Ein Rahmen in Hintergrundfarbe deckt die überstehenden Ecken ab.
export component CornerMask inherits Rectangle {
    in property <color> outside;
    // Verwendung: x: -10px; y: -10px; width: parent.width + 20px; height: parent.height + 20px;
    in property <length> radius;
    border-radius: root.radius + 10px;
    border-width: 10px;
    border-color: root.outside;
}
